<?xml version="1.0" ?>
<!--
  coverage_test.world — fixed benchmark scene for coverage-path evaluation.

  Everything here is deterministic: there is no randomness, no clutter that
  moves, and no sensor noise added by the world itself. The point is that two
  runs of the same duration on the same scene produce comparable numbers. If a
  run is not reproducible, the coverage percentage it produces is meaningless.

  Layout (interior, metres). Origin at the centre of the floor, z=0 on the floor.

    x in [-3.50, 3.50], y in [-2.50, 2.50], wall height 2.50

    A partition at x = 1.00 splits the space. Its doorway sits at y in [0.90, 1.90]
    and carries a 20 mm threshold — the only way between the two halves.

    West room                          East room
      table, centre (-2.30,  1.50)       empty floor, kept clear on purpose
      sofa,  centre (-2.30, -1.70)
      gap rig along y = 0
      curtain, a hanging phantom obstacle

  Five things are being tested, each deliberately isolated:
    1. thin obstacles      table legs, 50 mm diameter
    2. solid furniture     sofa, reachable by the scan, honest about its extent
    3. blind obstacles     low barrier, below the scan plane and invisible
    4. corners             room corners plus a concave corner at the partition
    5. gap widths          0.35 / 0.50 / 0.70 m, for the costmap sweep

  See ../README.md for how to run it and how coverage is measured.

  Robot assumed here is oomwoo-one: 349 mm body diameter, body cylinder from
  12.5 mm to 79 mm above the floor, scanner sweeping at 88 mm. Those three
  numbers are what make the low barrier invisible and the gap rig meaningful,
  so if the robot changes, revisit both. Room dimensions stay fixed across the
  project so results remain comparable between runs and between people.
-->
<sdf version="1.6">
  <world name="coverage_test">

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.72 0.75 0.78 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Fixed step. Do not raise max_step_size: the threshold climb depends on
         contact resolution, and a coarser step makes the result non-repeatable. -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <real_time_factor>1.0</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
        </constraints>
      </ode>
    </physics>

    <!-- ================= walls ================= -->

    <model name="wall_north">
      <static>true</static>
      <pose>0 2.55 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>7.2 0.1 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>7.2 0.1 2.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -2.55 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>7.2 0.1 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>7.2 0.1 2.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-3.55 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 5.0 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 5.0 2.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>3.55 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 5.0 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 5.0 2.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ============ partition with a 1.0 m doorway ============ -->

    <model name="partition_south">
      <static>true</static>
      <pose>1.0 -0.80 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 3.4 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 3.4 2.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <model name="partition_north">
      <static>true</static>
      <pose>1.0 2.20 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 0.6 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 0.6 2.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <!-- 20 mm threshold, floor to 0.02, spanning the doorway -->
    <model name="threshold">
      <static>true</static>
      <pose>1.0 1.40 0.01 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.16 1.0 0.02</size></box></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="v"><geometry><box><size>0.16 1.0 0.02</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ============ table: top above LiDAR, legs at LiDAR height ============
         The top sits at 0.70 m, which a low-mounted scanner does not see. The
         robot must therefore navigate between four 50 mm legs using only the
         legs themselves. This is the thin-obstacle test. -->

    <model name="table">
      <static>true</static>
      <pose>-2.30 1.50 0 0 0 0</pose>

      <link name="top">
        <pose>0 0 0.72 0 0 0</pose>
        <collision name="c"><geometry><box><size>1.3 0.9 0.04</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.3 0.9 0.04</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>
      </link>

      <link name="leg_fl">
        <pose>-0.30 0.40 0.35 0 0 0</pose>
        <collision name="c"><geometry><cylinder><radius>0.025</radius><length>0.7</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.025</radius><length>0.7</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>
      </link>

      <link name="leg_fr">
        <pose>0.30 0.40 0.35 0 0 0</pose>
        <collision name="c"><geometry><cylinder><radius>0.025</radius><length>0.7</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.025</radius><length>0.7</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>
      </link>

      <link name="leg_bl">
        <pose>-0.30 -0.40 0.35 0 0 0</pose>
        <collision name="c"><geometry><cylinder><radius>0.025</radius><length>0.7</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.025</radius><length>0.7</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>
      </link>

      <link name="leg_br">
        <pose>0.30 -0.40 0.35 0 0 0</pose>
        <collision name="c"><geometry><cylinder><radius>0.025</radius><length>0.7</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.025</radius><length>0.7</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ============ sofa: solid all the way to the floor ============
         The skirt reaches the ground, so the LiDAR is telling the truth when it
         reports a wall. Its east end leaves a 0.40 m gap to the east wall. -->

    <model name="sofa">
      <static>true</static>
      <pose>-2.30 -1.70 0.425 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.4 0.9 0.85</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.4 0.9 0.85</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ============ low barrier: invisible to the scanner ============
         A 50 mm ledge across the room, a stand-in for a cable, a rug edge or
         the foot of a piece of furniture.

         Why it is invisible, in the robot's own numbers: the body cylinder runs
         from 12.5 mm (floor clearance) to 79 mm, and the scanner sweeps at
         88 mm. It burns straight over anything shorter than 79 mm, while the
         body's lower edge plows into anything taller than 12.5 mm. That leaves
         a blind band from 12.5 mm to 79 mm where the robot is hit by something
         it cannot see at all — 50 mm sits in the middle of it.

         This is the case the whole contact-tolerant argument rests on, and it
         is the opposite of a phantom obstacle. The scanner is not lying; it is
         simply not looking down there. The planner will route straight through
         this barrier, report nothing wrong, and be wrong. Only the bumper
         finds out. -->

    <model name="low_barrier">
      <static>true</static>
      <pose>-0.60 -1.70 0.025 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.04 1.20 0.05</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.04 1.20 0.05</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ============ gap rig: three fixed pass widths ============
         A calibration instrument rather than a realistic object — it stands in
         for chair legs and railings. The three gaps are 0.35 / 0.50 / 0.70 m.
         With a 0.35 m body the first is impassable, the second is tight enough
         that inflation decides the outcome, and the third should always pass.
         Sweeping the costmap inflation against these three numbers is what
         phase 3 measures. -->

    <model name="gap_rig">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>

      <link name="block_a">
        <pose>-2.80 0 0.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.4 0.3 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 0.3 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material>
        </visual>
      </link>

      <!-- gap 0.35 -->
      <link name="block_b">
        <pose>-2.05 0 0.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.4 0.3 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 0.3 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material>
        </visual>
      </link>

      <!-- gap 0.50 -->
      <link name="block_c">
        <pose>-1.15 0 0.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.4 0.3 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 0.3 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material>
        </visual>
      </link>

      <!-- gap 0.70 -->
      <link name="block_d">
        <pose>-0.05 0 0.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.4 0.3 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 0.3 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
